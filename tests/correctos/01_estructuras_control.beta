inicio {
    entero i = 3;
    entero total = 0;

    para (entero j = 3; j > 0; 1) {
        si ((j >= 2) & (i > 0)) {
            total = total + j;
        } sino {
            total = total - 1;
        }
    }

    si ((total > 0) | (i == 0)) {
        imprimir("Estructuras correctas", total);
    } sino {
        imprimir("Incorrecto");
    }
}
