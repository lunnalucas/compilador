inicio {
    entero contador = 4;
    real resultado = 2.5;

    para (contador = 4; contador >= 0; 1) {
        si ((contador == 0) | (contador == 4)) {
            resultado = resultado + contador;
        } sino {
            resultado = resultado - 0.5;
        }
    }

    imprimir("Resultado final", resultado);
}
